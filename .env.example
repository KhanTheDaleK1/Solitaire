# Firebase Authentication Configuration
# Create a free project at https://console.firebase.google.com
# Enable Google & GitHub providers in Firebase Authentication -> Sign-in method

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=solitare-your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=solitare-your-project
VITE_FIREBASE_STORAGE_BUCKET=solitare-your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
